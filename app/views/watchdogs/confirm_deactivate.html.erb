<div class="max-w-md mx-auto">
  <% if @watchdog %>
    <% destination = @watchdog.to_airport.presence || @watchdog.to_country %>
    <div class="panel p-8 text-center">
      <h1 class="text-2xl font-medium tracking-tight mb-2">
        <%= t(:'watchdog.confirm_deactivate_title') %>
      </h1>
      <p class="text-text-mute text-sm mb-6"><%= t(:'watchdog.confirm_deactivate_body') %></p>

      <div class="font-mono text-lg mb-8">
        <%= @watchdog.from_airport %>
        <span class="text-text-mute mx-2">→</span>
        <%= destination %>
      </div>

      <%= button_to deactivate_watchdog_by_token_path(token: params[:token]), method: :patch,
            class: "btn-primary inline-flex" do %>
        <%= render "shared/icon", name: "power", css: "w-4 h-4" %>
        <%= t(:'watchdog.deactivate') %>
      <% end %>
    </div>
  <% else %>
    <div class="panel p-8 text-center">
      <h1 class="text-2xl font-medium tracking-tight mb-2">
        <%= t(:'watchdog.token_invalid_title') %>
      </h1>
      <p class="text-text-mute text-sm mb-6"><%= t(:'watchdog.token_invalid_body') %></p>
      <%= link_to t(:back), root_path, class: "btn-ghost inline-flex" %>
    </div>
  <% end %>
</div>
