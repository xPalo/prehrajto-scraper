<p style="margin:0 0 16px; font-size:16px; color:#0a0a0a;">
  Ahoj,
</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p style="margin:0 0 8px; font-size:15px; color:#3a3a3a;">
    E-mail tvojho účtu sa mení na <%= @resource.unconfirmed_email %>.
  </p>
<% else %>
  <p style="margin:0 0 8px; font-size:15px; color:#3a3a3a;">
    E-mail tvojho účtu bol zmenený na <%= @resource.email %>.
  </p>
<% end %>

<p style="margin:0; font-size:13px; color:#6b6b6b;">
  Ak si túto zmenu nevykonal/a ty, okamžite nás kontaktuj.
</p>
